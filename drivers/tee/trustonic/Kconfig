config TRUSTONIC_TEE
	bool "Trustonic MobiCore TEE support"
	depends on ARM64 && ARCH_EXYNOS
	select DMA_SHARED_BUFFER
	help
	  Enable the Trustonic MobiCore interface used by the secure-world
	  firmware on Samsung Exynos9810 devices.

config TRUSTONIC_TEE_LPAE
	bool "Use 64-bit Trustonic physical addresses"
	depends on TRUSTONIC_TEE
	default y if ARM64
	help
	  Enable the long physical address format used by the Exynos9810
	  secure-world firmware.
